{
  "manifest_version": 3,
  "name": "知乎 · 暗色 IDE 皮肤",
  "short_name": "知乎 IDE",
  "version": "1.6.3",
  "description": "把知乎重绘为暗色 IDE 界面：活动栏、文件树、标签页、minimap、状态栏，正文按代码编辑器排版。两种版式：融合（代码单元插进正文流，与段落同步出现）与分栏（右侧变更审阅 diff）。接管首页信息流 / 搜索 / 专栏列表，悬浮搜索框按 Ctrl+K 唤起。完全本地运行，不联网、不采集数据。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
